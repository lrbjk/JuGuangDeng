  m_Script: {fileID: 11500000, guid: ee31ac7d638499646b75c4bd9fb137f2, type: 3}
  m_Name: DefaultEndScreenCopy
  m_EditorClassIdentifier: RainbowLi.Runtime::RainbowLi.UnityGame.EndScreenCopy
  successTitle: "\u6E38\u620F\u6210\u529F"
  successBody: "\u606D\u559C\u60A8\u6210\u529F\u901A\u8FC7\u672C\u6B21\u6D4B\u8BD5\u3002\u8BF7\u5728\u7ED3\u675F\u6D4B\u8BD5\u540E\uFF0C\u8DDF\u968F\u5DE5\u4F5C\u4EBA\u5458\u7684\u5F15\u5BFC\u524D\u5F80\u201C\u56FE\u4E66\u9986\u201D\u5B8C\u6210\u540D\u79F0\u7559\u5B58\u5DE5\u4F5C\u3002\n\n\u6211\u4EEC\u5C06\u4F1A\u6839\u636E\u6B64\u6B21\u6D4B\u8BD5\u7ED3\u679C\uFF0C\u5BF9\u60A8\u7684\u60C5\u51B5\u8FDB\u884C\u66F4\u8FDB\u4E00\u6B65\u7684\u8BC4\u4F30\u3002\u5728\u8BC4\u4F30\u7ED3\u679C\u51FA\u6765\u524D\uFF0C\u60A8\u53EF\u4EE5\u81EA\u7531\u53C2\u89C2\u8BBE\u65BD\u7684\u5F00\u653E\u533A\u57DF\uFF0C\u4EE5\u4FBF\u4E8E\u4E86\u89E3\u60A8\u6B64\u540E\u7684\u5DE5\u4F5C\u73AF\u5883\u4E0E\u5185\u5BB9\u3002\n\n\u6700\u540E\uFF0C\u771F\u631A\u7684\u6B22\u8FCE\u60A8\u52A0\u5165\u6211\u4EEC\u2014\u2014\u201C\u9B54\u6CD5\u5C01\u5B58\u5C40\u201D\u3002"
  failureTitle: "\u6E38\u620F\u5931\u8D25"
  failureBody: "\u5F88\u9057\u61BE\uFF0C\u60A8\u672A\u80FD\u901A\u8FC7\u672C\u6B21\u6D4B\u8BD5\u3002\u8BF7\u5728\u7ED3\u675F\u6D4B\u8BD5\u540E\uFF0C\u8DDF\u968F\u5DE5\u4F5C\u4EBA\u5458\u7684\u5F15\u5BFC\u524D\u5F80\u201C\u8BB0\u5FC6\u5C01\u5B58\u90E8\u95E8\u201D\u8FDB\u884C\u76F8\u5173\u540E\u7EED\u5DE5\u4F5C\u3002\n\n\u4E3A\u4E86\u786E\u4FDD\u60A8\u6B64\u540E\u7684\u751F\u6D3B\u4E0D\u53D7\u5230\u5F71\u54CD\uFF0C\u6211\u4EEC\u5EFA\u8BAE\u60A8\u5728\u201C\u8BB0\u5FC6\u5C01\u5B58\u90E8\u95E8\u201D\u5B8C\u6210\u5DE5\u4F5C\u4E4B\u524D\u8D2D\u4E70\u76F8\u5173\u4FDD\u9669\uFF0C\u4EE5\u786E\u4FDD\u60A8\u4ECA\u540E\u7684\u751F\u6D3B\u4E0D\u4F1A\u53D7\u5230\u592A\u5927\u53D8\u5316\u3002\n\n\u611F\u8C22\u60A8\u7684\u53C2\u4E0E\uFF0C\u671F\u5F85\u6211\u4EEC\u80FD\u6709\u673A\u4F1A\u518D\u89C1\u3002"
